<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="{{ csrfToken }}" />
    <title>
      {{
        $props.has('title')
                          ? `${$props.get('title')} · SnapFile`
                          : 'SnapFile'
      }}
    </title>
    <script>
      // Apply a saved theme before first paint so the page does not flash
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <button
      type="button"
      class="theme-toggle"
      x-data="themeToggle"
      x-cloak
      @click="toggle"
      :aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'"
    >
      <svg x-show="!dark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 14.1A8.5 8.5 0 1 1 9.9 3.5a6.6 6.6 0 0 0 10.6 10.6Z" />
      </svg>
      <svg x-show="dark" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path
          d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
        />
      </svg>
    </button>
    <main>
      @include('partials/flash_alerts')
      {{{ await $slots.main() }}}
    </main>
    <footer class="site-footer">
      © 2026 <a href="https://ericvondee.xyz" target="_blank" rel="noopener">Eric Vondee</a>. All rights reserved.
    </footer>
  </body>
</html>
